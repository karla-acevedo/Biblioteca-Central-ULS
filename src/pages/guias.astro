---
import PageLayout from '../layouts/PageLayout.astro';

const guias = [
  { title: 'Guía de fondos documentales',      desc: 'Cómo localizar y consultar los fondos especiales de la biblioteca.', cat: 'Fondos' },
  { title: 'Cómo citar en formato APA 7',      desc: 'Manual rápido para citar correctamente en APA séptima edición.',     cat: 'Citado' },
  { title: 'Cómo citar en formato MLA',        desc: 'Guía sintética del estilo MLA con ejemplos.',                          cat: 'Citado' },
  { title: 'Búsqueda en bases de datos',       desc: 'Estrategias de búsqueda con operadores booleanos y truncamiento.',     cat: 'Investigación' },
  { title: 'Acceso a recursos electrónicos',   desc: 'Cómo acceder a recursos electrónicos suscritos desde casa.',           cat: 'Recursos' },
  { title: 'Gestores bibliográficos: Zotero',  desc: 'Introducción al uso de Zotero para organizar tus referencias.',        cat: 'Investigación' },
];
---

<PageLayout
  title="Guías de investigación · Biblioteca Central ULS"
  description="Guías de fondos documentales y guías de apoyo a la investigación."
  eyebrow="Apoyo"
  heading="Guías de investigación"
  subheading="Recursos para apoyar tu trabajo académico y orientarte en los fondos documentales."
>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {guias.map((g) => (
      <li>
        <article class="flex h-full flex-col rounded-2xl border border-blue-200 bg-white p-6 transition hover:border-blue-400 hover:bg-blue-50">
          <span class="text-xs font-semibold uppercase tracking-wide text-blue-600">{g.cat}</span>
          <h2 class="mt-2 font-display text-lg font-semibold text-stone-900">{g.title}</h2>
          <p class="mt-2 flex-1 text-sm text-stone-700">{g.desc}</p>
          <a href="/contacto" class="mt-4 self-start text-sm font-semibold text-blue-600 hover:text-blue-800">
            Solicitar la guía →
          </a>
        </article>
      </li>
    ))}
  </ul>
</PageLayout>
