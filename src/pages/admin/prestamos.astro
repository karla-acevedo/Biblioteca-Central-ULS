---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopUtilityBar from '../../components/TopUtilityBar.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<BaseLayout
  title="Gestión de Préstamos · Admin · Biblioteca Central ULS"
  description="Ver y administrar préstamos del sistema."
>
  <TopUtilityBar />
  <AnnouncementBar />
  <SiteHeader />

  <main id="contenido-principal" class="min-h-screen bg-blue-50">

    <!-- Cabecera -->
    <div class="border-b border-blue-300 bg-gradient-to-r from-blue-600 to-blue-800 px-4 py-10">
      <div class="mx-auto max-w-7xl">
        <a href="/admin" class="inline-flex items-center text-sm font-medium text-white/80 hover:text-white">
          ← Volver al panel
        </a>
        <h1 class="font-display mt-2 text-3xl font-semibold text-white sm:text-4xl">Gestión de Préstamos</h1>
        <p class="mt-3 max-w-3xl text-white/80">Lista de todos los préstamos del sistema. Puedes marcar como devueltos los préstamos activos.</p>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-12 lg:px-6">

      <!-- Alerta -->
      <div id="alerta" class="hidden mb-6 rounded-lg border px-4 py-3 text-sm font-medium"></div>

      <!-- Filtros -->
      <div class="mb-6 flex flex-wrap gap-2">
        <button data-filtro="todos"    class="filtro rounded-full bg-blue-600 px-4 py-1.5 text-sm font-semibold text-white">Todos</button>
        <button data-filtro="activo"   class="filtro rounded-full border border-blue-300 bg-white px-4 py-1.5 text-sm font-semibold text-blue-700 hover:bg-blue-50">Activos</button>
        <button data-filtro="vencido"  class="filtro rounded-full border border-blue-300 bg-white px-4 py-1.5 text-sm font-semibold text-blue-700 hover:bg-blue-50">Vencidos</button>
        <button data-filtro="devuelto" class="filtro rounded-full border border-blue-300 bg-white px-4 py-1.5 text-sm font-semibold text-blue-700 hover:bg-blue-50">Devueltos</button>
      </div>

      <!-- Resumen contadores -->
      <div class="mb-6 grid gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-blue-200 bg-white p-4 text-center">
          <p class="text-xs font-semibold uppercase text-stone-500">Total</p>
          <p id="cntTotal" class="mt-1 text-2xl font-bold text-blue-700">—</p>
        </div>
        <div class="rounded-xl border border-blue-200 bg-white p-4 text-center">
          <p class="text-xs font-semibold uppercase text-stone-500">Activos</p>
          <p id="cntActivo" class="mt-1 text-2xl font-bold text-green-700">—</p>
        </div>
        <div class="rounded-xl border border-blue-200 bg-white p-4 text-center">
          <p class="text-xs font-semibold uppercase text-stone-500">Vencidos</p>
          <p id="cntVencido" class="mt-1 text-2xl font-bold text-red-700">—</p>
        </div>
        <div class="rounded-xl border border-blue-200 bg-white p-4 text-center">
          <p class="text-xs font-semibold uppercase text-stone-500">Devueltos</p>
          <p id="cntDevuelto" class="mt-1 text-2xl font-bold text-stone-600">—</p>
        </div>
      </div>

      <!-- Lista de préstamos -->
      <p id="estado" class="text-sm text-stone-600">Cargando préstamos...</p>
      <div id="listaPrestamos" class="hidden space-y-3"></div>

    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    // Admin guard
    const u = localStorage.getItem('uls_usuario');
    const usuario = u ? JSON.parse(u) : null;
    if (!usuario || usuario.rol !== 'admin') {
      alert('Acceso denegado.');
      window.location.href = '/login';
      return;
    }

    const $alerta = document.getElementById('alerta');
    const $estado = document.getElementById('estado');
    const $lista  = document.getElementById('listaPrestamos');
    let prestamos = [];
    let filtroActual = 'todos';

    function mostrarAlerta(msg, tipo) {
      $alerta.textContent = msg;
      $alerta.className = 'mb-6 rounded-lg border px-4 py-3 text-sm font-medium';
      if (tipo === 'error') {
        $alerta.classList.add('bg-red-50', 'text-red-700', 'border-red-200');
      } else {
        $alerta.classList.add('bg-green-50', 'text-green-700', 'border-green-200');
      }
      setTimeout(() => $alerta.classList.add('hidden'), 4000);
    }

    function fmtFecha(iso) {
      if (!iso) return '—';
      const f = iso.length > 10 ? new Date(iso) : new Date(iso + 'T00:00:00');
      return f.toLocaleDateString('es-SV', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function actualizarContadores() {
      const cnt = { todos: prestamos.length, activo: 0, vencido: 0, devuelto: 0 };
      prestamos.forEach(p => { cnt[p.estado] = (cnt[p.estado] || 0) + 1; });
      document.getElementById('cntTotal').textContent    = cnt.todos;
      document.getElementById('cntActivo').textContent   = cnt.activo;
      document.getElementById('cntVencido').textContent  = cnt.vencido;
      document.getElementById('cntDevuelto').textContent = cnt.devuelto;
    }

    function renderLista() {
      const filtrados = filtroActual === 'todos'
        ? prestamos
        : prestamos.filter(p => p.estado === filtroActual);

      if (filtrados.length === 0) {
        $lista.classList.add('hidden');
        $estado.classList.remove('hidden');
        $estado.textContent = filtroActual === 'todos'
          ? 'No hay préstamos registrados.'
          : `No hay préstamos en estado "${filtroActual}".`;
        return;
      }

      $estado.classList.add('hidden');
      $lista.classList.remove('hidden');

      const estadoBadge = {
        activo:   'bg-green-100 text-green-700 border-green-200',
        vencido:  'bg-red-100 text-red-700 border-red-200',
        devuelto: 'bg-stone-100 text-stone-700 border-stone-200',
      };

      $lista.innerHTML = filtrados.map(p => `
        <article class="rounded-xl border border-blue-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-semibold text-stone-900">📖 ${p.libroTitulo}</h3>
                <span class="rounded-full border px-2.5 py-0.5 text-xs font-semibold ${estadoBadge[p.estado] || ''}">${p.estado}</span>
              </div>
              <p class="mt-1 text-sm text-stone-600">por ${p.libroAutor}</p>
              <div class="mt-3 grid gap-1 text-sm sm:grid-cols-2">
                <p><span class="font-semibold text-stone-500">Usuario:</span> ${p.usuarioNombre}</p>
                <p><span class="font-semibold text-stone-500">Préstamo #:</span> ${p.id}</p>
                <p><span class="font-semibold text-stone-500">Prestado:</span> ${fmtFecha(p.fechaPrestamo)}</p>
                <p><span class="font-semibold text-stone-500">Devolver:</span> ${fmtFecha(p.fechaDevolucion)}</p>
                ${p.fechaRetorno ? `<p class="sm:col-span-2"><span class="font-semibold text-stone-500">Devuelto el:</span> ${fmtFecha(p.fechaRetorno)}</p>` : ''}
              </div>
            </div>
            ${!p.devuelto ? `
              <button data-id="${p.id}" class="btnDevolver shrink-0 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">
                Marcar devuelto
              </button>
            ` : ''}
          </div>
        </article>
      `).join('');

      document.querySelectorAll('.btnDevolver').forEach(btn => {
        btn.addEventListener('click', () => marcarDevuelto(Number(btn.dataset.id)));
      });
    }

    async function cargarPrestamos() {
      try {
        const res = await fetch('/api/prestamos?todos=true');
        const data = await res.json();
        prestamos = data.prestamos || [];

        // Ordenar: activos primero, luego vencidos, devueltos al final; dentro de cada grupo por fecha desc
        const orden = { activo: 0, vencido: 1, devuelto: 2 };
        prestamos.sort((a, b) => {
          if (orden[a.estado] !== orden[b.estado]) return orden[a.estado] - orden[b.estado];
          return b.fechaPrestamo.localeCompare(a.fechaPrestamo);
        });

        actualizarContadores();
        renderLista();
      } catch (err) {
        console.error(err);
        $estado.textContent = 'Error al cargar los préstamos.';
        $estado.classList.add('text-red-600');
      }
    }

    async function marcarDevuelto(id) {
      if (!confirm('¿Confirmar la devolución de este libro?')) return;

      try {
        const res = await fetch(`/api/prestamos?id=${id}`, { method: 'PUT' });
        const data = await res.json();
        if (data.success) {
          mostrarAlerta(data.mensaje || 'Devolución registrada.', 'ok');
          await cargarPrestamos();
        } else {
          mostrarAlerta(data.error || 'No se pudo procesar la devolución.', 'error');
        }
      } catch (err) {
        console.error(err);
        mostrarAlerta('Error de conexión.', 'error');
      }
    }

    // Filtros
    document.querySelectorAll('.filtro').forEach(btn => {
      btn.addEventListener('click', () => {
        filtroActual = btn.dataset.filtro;
        // Activar visualmente el botón seleccionado
        document.querySelectorAll('.filtro').forEach(b => {
          b.className = 'filtro rounded-full border border-blue-300 bg-white px-4 py-1.5 text-sm font-semibold text-blue-700 hover:bg-blue-50';
        });
        btn.className = 'filtro rounded-full bg-blue-600 px-4 py-1.5 text-sm font-semibold text-white';
        renderLista();
      });
    });

    cargarPrestamos();
  });
</script>
