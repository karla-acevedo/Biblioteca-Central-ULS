---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopUtilityBar from '../../components/TopUtilityBar.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<BaseLayout
  title="Gestión de Usuarios · Admin · Biblioteca Central ULS"
  description="Administra los usuarios registrados en el sistema."
>
  <TopUtilityBar />
  <AnnouncementBar />
  <SiteHeader />

  <main id="contenido-principal" class="min-h-screen bg-blue-50">

    <!-- Cabecera -->
    <div class="border-b border-blue-300 bg-gradient-to-r from-blue-600 to-blue-800 px-4 py-10">
      <div class="mx-auto max-w-7xl">
        <a href="/admin" class="inline-flex items-center text-sm font-medium text-white/80 hover:text-white">
          ← Volver al panel
        </a>
        <h1 class="font-display mt-2 text-3xl font-semibold text-white sm:text-4xl">Gestión de Usuarios</h1>
        <p class="mt-3 max-w-3xl text-white/80">Lista de todos los usuarios registrados en el sistema.</p>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-12 lg:px-6">

      <!-- Mensaje vacío / cargando -->
      <p id="estado" class="text-sm text-stone-600">Cargando usuarios...</p>

      <!-- Lista de usuarios -->
      <div id="listaUsuarios" class="hidden grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

      <!-- Estadísticas al final -->
      <p id="totalLabel" class="mt-8 hidden text-sm text-stone-500"></p>

    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  window.addEventListener('DOMContentLoaded', async () => {
    // Verificar admin
    const u = localStorage.getItem('uls_usuario');
    const usuario = u ? JSON.parse(u) : null;
    if (!usuario || usuario.rol !== 'admin') {
      alert('Acceso denegado.');
      window.location.href = '/login';
      return;
    }

    const estado = document.getElementById('estado');
    const lista = document.getElementById('listaUsuarios');
    const totalLabel = document.getElementById('totalLabel');

    try {
      const res = await fetch('/api/auth?action=usuarios');
      const data = await res.json();

      if (!data.success || !data.usuarios?.length) {
        estado.textContent = 'No hay usuarios registrados.';
        return;
      }

      estado.classList.add('hidden');
      lista.classList.remove('hidden');
      totalLabel.classList.remove('hidden');
      totalLabel.textContent = `Total: ${data.usuarios.length} usuario(s) registrado(s).`;

      lista.innerHTML = data.usuarios.map(u => {
        const fecha = u.creado ? new Date(u.creado).toLocaleDateString('es-SV', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
        const badgeColor = u.rol === 'admin'
          ? 'bg-blue-100 text-blue-700'
          : 'bg-stone-100 text-stone-700';
        const estadoColor = u.activo
          ? 'bg-green-100 text-green-700'
          : 'bg-red-100 text-red-700';

        return `
          <article class="rounded-xl border border-blue-200 bg-white p-5 shadow-sm">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="font-semibold text-stone-900 truncate">${u.nombre} ${u.apellido}</h3>
                <p class="text-sm text-stone-600 truncate">${u.email}</p>
              </div>
              <span class="text-xs text-stone-400">#${u.id}</span>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold ${badgeColor}">${u.rol}</span>
              <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold ${estadoColor}">${u.activo ? 'activo' : 'inactivo'}</span>
            </div>
            <p class="mt-3 text-xs text-stone-500">Registrado: ${fecha}</p>
          </article>
        `;
      }).join('');
    } catch (err) {
      console.error(err);
      estado.textContent = 'Error al cargar los usuarios.';
      estado.classList.add('text-red-600');
    }
  });
</script>
