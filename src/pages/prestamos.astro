---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopUtilityBar from '../components/TopUtilityBar.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Mis préstamos · Biblioteca Central ULS"
  description="Consulta y gestiona tus préstamos activos."
>
  <TopUtilityBar />
  <AnnouncementBar />
  <SiteHeader />

  <main id="contenido-principal" class="min-h-screen bg-stone-50">

    <div class="border-b border-[#1e3a5f] bg-gradient-to-r from-[#1a2f4e] to-[#0f1e33] px-4 py-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/60">Mi cuenta</p>
        <h1 class="font-display mt-2 text-3xl font-semibold text-white">Mis préstamos</h1>
        <p class="mt-2 text-white/70">Libros que tienes actualmente prestados.</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 py-8">

      <!-- Alerta -->
      <div id="alerta" class="hidden mb-4 rounded-lg px-4 py-3 text-sm font-medium"></div>

      <!-- Contenido -->
      <div id="contenido">
        <div class="py-16 text-center text-stone-400">
          <p class="text-4xl">⏳</p>
          <p class="mt-2 font-medium">Cargando préstamos…</p>
        </div>
      </div>

    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  // ── Mostrar alerta ────────────────────────────────────────────
  function mostrarAlerta(msg, tipo = 'exito') {
    const el = document.getElementById('alerta');
    el.textContent = msg;
    el.className = tipo === 'exito'
      ? 'mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800'
      : 'mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700';
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  // ── Cargar préstamos ──────────────────────────────────────────
  async function cargarPrestamos() {
    const usuario = JSON.parse(localStorage.getItem('uls_usuario') ?? 'null');

    if (!usuario) {
      document.getElementById('contenido').innerHTML = `
        <div class="rounded-2xl border border-stone-200 bg-white p-12 text-center shadow-sm">
          <p class="text-5xl mb-4">🔒</p>
          <h2 class="font-display text-xl font-semibold text-stone-900 mb-2">Inicia sesión primero</h2>
          <p class="text-stone-500 mb-6">Necesitas una cuenta para ver tus préstamos.</p>
          <a href="/login" class="inline-flex rounded-full bg-[#a51c30] px-6 py-2.5 text-sm font-bold text-white hover:bg-[#7a1525]">
            Iniciar sesión
          </a>
        </div>`;
      return;
    }

    try {
      const res   = await fetch(`/api/prestamos?usuarioId=${usuario.id}`);
      const datos = await res.json();
      renderizar(datos.prestamos ?? [], usuario);
    } catch {
      document.getElementById('contenido').innerHTML =
        `<p class="text-center text-red-500 py-12">Error al cargar préstamos.</p>`;
    }
  }

  // ── Renderizar tabla ──────────────────────────────────────────
  function renderizar(prestamos, usuario) {
    const activos   = prestamos.filter(p => p.estado !== 'devuelto');
    const devueltos = prestamos.filter(p => p.estado === 'devuelto');

    if (!prestamos.length) {
      document.getElementById('contenido').innerHTML = `
        <div class="rounded-2xl border border-stone-200 bg-white p-12 text-center shadow-sm">
          <p class="text-5xl mb-4">📭</p>
          <h2 class="font-display text-xl font-semibold text-stone-900 mb-2">Sin préstamos</h2>
          <p class="text-stone-500 mb-6">No tienes ningún libro prestado actualmente.</p>
          <a href="/catalogo" class="inline-flex rounded-full bg-[#a51c30] px-6 py-2.5 text-sm font-bold text-white hover:bg-[#7a1525]">
            Ver catálogo
          </a>
        </div>`;
      return;
    }

    const filaActivo = (p) => `
      <tr class="border-b border-stone-100 hover:bg-stone-50 transition">
        <td class="px-4 py-3">
          <p class="font-semibold text-stone-900 text-sm">${p.libroTitulo}</p>
          <p class="text-xs text-stone-400">${p.libroAutor}</p>
        </td>
        <td class="px-4 py-3 text-sm text-stone-600">${p.fechaPrestamo}</td>
        <td class="px-4 py-3 text-sm ${p.estado === 'vencido' ? 'font-bold text-red-600' : 'text-stone-600'}">${p.fechaDevolucion}</td>
        <td class="px-4 py-3">
          ${p.estado === 'activo'
            ? '<span class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">Activo</span>'
            : '<span class="rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-700">Vencido</span>'
          }
        </td>
        <td class="px-4 py-3">
          <button
            onclick="devolver(${p.id})"
            class="rounded-lg border border-stone-200 bg-white px-3 py-1.5 text-xs font-semibold text-stone-700 transition hover:border-green-300 hover:text-green-700"
          >
            Devolver
          </button>
        </td>
      </tr>`;

    const filaDevuelto = (p) => `
      <tr class="border-b border-stone-100 opacity-60">
        <td class="px-4 py-3">
          <p class="font-semibold text-stone-900 text-sm">${p.libroTitulo}</p>
          <p class="text-xs text-stone-400">${p.libroAutor}</p>
        </td>
        <td class="px-4 py-3 text-sm text-stone-600">${p.fechaPrestamo}</td>
        <td class="px-4 py-3 text-sm text-stone-600">${p.fechaRetorno?.split('T')[0] ?? '—'}</td>
        <td class="px-4 py-3" colspan="2">
          <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-500">Devuelto</span>
        </td>
      </tr>`;

    document.getElementById('contenido').innerHTML = `
      <!-- Préstamos activos -->
      ${activos.length ? `
        <div class="mb-6 overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-sm">
          <div class="border-b border-blue-100 bg-blue-50 px-6 py-4">
            <h2 class="font-display text-lg font-semibold text-blue-900">Préstamos activos (${activos.length})</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-blue-100 bg-blue-50/50 text-xs font-bold uppercase tracking-wide text-blue-400">
                  <th class="px-4 py-3">Libro</th>
                  <th class="px-4 py-3">Prestado</th>
                  <th class="px-4 py-3">Devolver antes de</th>
                  <th class="px-4 py-3">Estado</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody>${activos.map(filaActivo).join('')}</tbody>
            </table>
          </div>
        </div>
      ` : ''}

      <!-- Historial devueltos -->
      ${devueltos.length ? `
        <div class="overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-sm">
          <div class="border-b border-blue-100 bg-blue-50 px-6 py-4">
            <h2 class="font-display text-lg font-semibold text-blue-900">Historial (${devueltos.length})</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-stone-100 bg-stone-50 text-xs font-bold uppercase tracking-wide text-stone-400">
                  <th class="px-4 py-3">Libro</th>
                  <th class="px-4 py-3">Prestado</th>
                  <th class="px-4 py-3">Devuelto</th>
                  <th class="px-4 py-3" colspan="2">Estado</th>
                </tr>
              </thead>
              <tbody>${devueltos.map(filaDevuelto).join('')}</tbody>
            </table>
          </div>
        </div>
      ` : ''}

      <div class="mt-6 text-center">
        <a href="/catalogo" class="inline-flex rounded-full border border-stone-300 px-5 py-2 text-sm font-semibold text-stone-700 hover:border-[#a51c30] hover:text-[#a51c30] transition">
          ← Ver catálogo de libros
        </a>
      </div>
    `;
  }

  // ── Devolver libro ────────────────────────────────────────────
  async function devolver(prestamoId) {
    if (!confirm('¿Confirmas la devolución de este libro?')) return;

    try {
      const res   = await fetch(`/api/prestamos?id=${prestamoId}`, { method: 'PUT' });
      const datos = await res.json();

      if (datos.error) {
        mostrarAlerta(datos.error, 'error');
      } else {
        mostrarAlerta(datos.mensaje ?? 'Libro devuelto correctamente.');
        cargarPrestamos();
      }
    } catch {
      mostrarAlerta('Error de conexión.', 'error');
    }
  }

  // ── Iniciar ───────────────────────────────────────────────────
  cargarPrestamos();
</script>