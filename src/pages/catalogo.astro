---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopUtilityBar from '../components/TopUtilityBar.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Catálogo · Biblioteca Central ULS"
  description="Explora todos los libros disponibles en la Biblioteca Central ULS."
>
  <TopUtilityBar />
  <AnnouncementBar />
  <SiteHeader />

  <main id="contenido-principal" class="min-h-screen bg-blue-50">

    <!-- Encabezado de página -->
    <div class="border-b border-[#5b9fd4] bg-gradient-to-r from-[#5b9fd4] to-[#3b82c4] px-4 py-8">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/60">Biblioteca Central ULS</p>
        <h1 class="font-display mt-2 text-3xl font-semibold text-white sm:text-4xl">Catálogo de libros</h1>
        <p class="mt-2 text-white/70">Encuentra, consulta y solicita préstamos de nuestros libros.</p>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-8">

      <!-- Barra de filtros -->
      <div class="mb-6 flex flex-wrap items-center gap-3 rounded-2xl border border-blue-200 bg-white p-4 shadow-sm">
        <!-- Buscador -->
        <div class="relative flex-1 min-w-[200px]">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-blue-400">🔍</span>
          <input
            id="buscador"
            type="search"
            placeholder="Buscar por título, autor o ISBN…"
            oninput="filtrar()"
            class="w-full rounded-lg border border-blue-200 bg-blue-50 py-2.5 pl-9 pr-4 text-sm text-blue-900 outline-none transition placeholder:text-blue-300 focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-200"
          />
        </div>
        <!-- Categoría -->
        <select
          id="filtroCategoria"
          onchange="filtrar()"
          class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2.5 text-sm text-blue-900 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-200"
        >
          <option value="">Todas las categorías</option>
          <option>Tecnología</option>
          <option>Historia</option>
          <option>Ciencias</option>
          <option>Literatura</option>
          <option>Matemáticas</option>
        </select>
        <!-- Solo disponibles -->
        <label class="flex cursor-pointer items-center gap-2 text-sm text-blue-700">
          <input id="soloDisp" type="checkbox" onchange="filtrar()" class="accent-[#1d6fad]" />
          Solo disponibles
        </label>
        <!-- Contador -->
        <span id="contador" class="ml-auto text-sm text-blue-400"></span>
      </div>

      <!-- Grid de libros -->
      <div id="gridLibros" class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        <div class="col-span-full py-16 text-center text-stone-400">
          <p class="text-4xl">⏳</p>
          <p class="mt-2 font-medium">Cargando libros…</p>
        </div>
      </div>

    </div>
  </main>

  <!-- Modal detalle libro -->
  <div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
    <div class="relative w-full max-w-md rounded-2xl bg-white shadow-2xl">
      <button
        onclick="cerrarModal()"
        class="absolute right-4 top-4 text-2xl text-stone-400 hover:text-stone-700"
      >×</button>
      <div id="modalContenido" class="p-6"></div>
    </div>
  </div>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  // ── Estado ────────────────────────────────────────────────────
  let todosLosLibros = [];

  const COLORES = {
    'Tecnología':  'bg-blue-200',
    'Historia':    'bg-amber-200',
    'Ciencias':    'bg-emerald-200',
    'Literatura':  'bg-purple-200',
    'Matemáticas': 'bg-yellow-200',
  };

  // ── Cargar libros al entrar ───────────────────────────────────
  async function cargarLibros() {
    try {
      const res   = await fetch('/api/libros');
      const datos = await res.json();
      todosLosLibros = datos.libros ?? [];
      renderizar(todosLosLibros);
    } catch {
      document.getElementById('gridLibros').innerHTML = `
        <div class="col-span-full py-16 text-center text-red-500">
          <p class="text-4xl">⚠️</p>
          <p class="mt-2 font-medium">Error al cargar los libros.</p>
        </div>`;
    }
  }

  // ── Filtrar ───────────────────────────────────────────────────
  function filtrar() {
    const q        = document.getElementById('buscador').value.toLowerCase();
    const cat      = document.getElementById('filtroCategoria').value;
    const soloDisp = document.getElementById('soloDisp').checked;

    let resultado = todosLosLibros;

    if (q)        resultado = resultado.filter(l =>
      l.titulo.toLowerCase().includes(q) ||
      l.autor.toLowerCase().includes(q)  ||
      l.isbn?.includes(q)
    );
    if (cat)      resultado = resultado.filter(l => l.categoria === cat);
    if (soloDisp) resultado = resultado.filter(l => l.disponibles > 0);

    renderizar(resultado);
  }

  // ── Renderizar grid ───────────────────────────────────────────
  function renderizar(libros) {
    const contador = document.getElementById('contador');
    contador.textContent = `${libros.length} libro${libros.length !== 1 ? 's' : ''}`;

    const grid = document.getElementById('gridLibros');

    if (!libros.length) {
      grid.innerHTML = `
        <div class="col-span-full py-16 text-center text-stone-400">
          <p class="text-4xl">📭</p>
          <p class="mt-2 font-medium">No se encontraron libros.</p>
        </div>`;
      return;
    }

    grid.innerHTML = libros.map(l => `
      <article
        onclick="abrirModal(${l.id})"
        class="group cursor-pointer overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <!-- Portada -->
        <div class="relative h-48 overflow-hidden bg-stone-100">
          <img
            src="${l.portada ?? 'https://covers.openlibrary.org/b/isbn/' + l.isbn + '-M.jpg'}"
            alt="Portada de ${l.titulo}"
            class="h-full w-full object-cover object-top"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="absolute inset-0 hidden items-center justify-center text-5xl ${COLORES[l.categoria] ?? 'bg-stone-200'}">
            ${l.emoji ?? '📚'}
          </div>
        </div>
        <!-- Info -->
        <div class="p-4">
          <span class="mb-2 inline-block rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-600">
            ${l.categoria}
          </span>
          <h2 class="font-display line-clamp-2 text-sm font-semibold leading-snug text-stone-900 group-hover:text-[#1d6fad]">
            ${l.titulo}
          </h2>
          <p class="mt-1 text-xs text-stone-400">${l.autor}</p>
          <p class="mt-2 text-xs font-semibold ${l.disponibles > 0 ? 'text-green-600' : 'text-red-500'}">
            ${l.disponibles > 0 ? `✓ ${l.disponibles} disponible${l.disponibles > 1 ? 's' : ''}` : '✗ Sin stock'}
          </p>
        </div>
      </article>
    `).join('');
  }

  // ── Abrir modal ───────────────────────────────────────────────
  function abrirModal(id) {
    const libro = todosLosLibros.find(l => l.id === id);
    if (!libro) return;

    const usuario = JSON.parse(localStorage.getItem('uls_usuario') ?? 'null');
    const puedePrestar = usuario && libro.disponibles > 0;

    document.getElementById('modalContenido').innerHTML = `
      <div class="flex gap-4 items-start mb-4">
        <div class="flex h-24 w-16 flex-shrink-0 overflow-hidden rounded-xl">
          <img
            src="${libro.portada ?? 'https://covers.openlibrary.org/b/isbn/' + libro.isbn + '-M.jpg'}"
            alt="Portada"
            class="h-full w-full object-cover object-top"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden h-24 w-16 flex-shrink-0 items-center justify-center rounded-xl text-4xl ${COLORES[libro.categoria] ?? 'bg-stone-200'}">
            ${libro.emoji ?? '📚'}
          </div>
        </div>
        <div>
          <span class="inline-block rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-600 mb-1">${libro.categoria}</span>
          <h2 class="font-display text-lg font-semibold text-stone-900 leading-snug">${libro.titulo}</h2>
          <p class="text-sm text-stone-500">${libro.autor} · ${libro.anio}</p>
        </div>
      </div>

      <p class="mb-4 text-sm text-stone-600 leading-relaxed">${libro.descripcion || 'Sin descripción disponible.'}</p>

      <div class="mb-4 rounded-lg bg-stone-50 p-3 text-sm space-y-1">
        <div class="flex justify-between"><span class="text-stone-400">ISBN</span><span class="font-medium">${libro.isbn || '—'}</span></div>
        <div class="flex justify-between"><span class="text-stone-400">Año</span><span class="font-medium">${libro.anio}</span></div>
        <div class="flex justify-between"><span class="text-stone-400">Copias totales</span><span class="font-medium">${libro.copias}</span></div>
        <div class="flex justify-between"><span class="text-stone-400">Disponibles</span>
          <span class="font-semibold ${libro.disponibles > 0 ? 'text-green-600' : 'text-red-500'}">${libro.disponibles}</span>
        </div>
      </div>

      <div id="areaPrestar">
        ${!usuario
          ? `<a href="/login" class="flex w-full items-center justify-center rounded-lg bg-[#1d6fad] py-2.5 text-sm font-bold text-white hover:bg-[#155a8a]">Inicia sesión para prestar</a>`
          : puedePrestar
          ? `<button onclick="solicitarPrestamo(${libro.id})" class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#1d6fad] py-2.5 text-sm font-bold text-white transition hover:bg-[#155a8a]">
               <span id="spinnerPrestar" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
               Solicitar préstamo (14 días)
             </button>`
          : `<button disabled class="w-full rounded-lg border border-stone-200 py-2.5 text-sm font-semibold text-stone-400 cursor-not-allowed">Sin copias disponibles</button>`
        }
      </div>
    `;

    document.getElementById('modal').classList.remove('hidden');
    document.getElementById('modal').classList.add('flex');
  }

  // ── Solicitar préstamo ────────────────────────────────────────
  async function solicitarPrestamo(libroId) {
    const usuario = JSON.parse(localStorage.getItem('uls_usuario') ?? 'null');
    if (!usuario) { window.location.href = '/login'; return; }

    const spinner = document.getElementById('spinnerPrestar');
    spinner.classList.remove('hidden');

    try {
      const res   = await fetch('/api/prestamos', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ usuarioId: usuario.id, libroId }),
      });
      const datos = await res.json();

      if (datos.error) {
        document.getElementById('areaPrestar').innerHTML =
          `<p class="rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700">${datos.error}</p>`;
      } else {
        document.getElementById('areaPrestar').innerHTML =
          `<p class="rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-700">✅ ${datos.mensaje}</p>`;
        // Actualizar disponibles en memoria
        const libro = todosLosLibros.find(l => l.id === libroId);
        if (libro) libro.disponibles -= 1;
      }
    } catch {
      document.getElementById('areaPrestar').innerHTML =
        `<p class="rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700">Error de conexión.</p>`;
    }
  }

  // ── Cerrar modal ──────────────────────────────────────────────
  function cerrarModal() {
    document.getElementById('modal').classList.add('hidden');
    document.getElementById('modal').classList.remove('flex');
  }

  // Cerrar con Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') cerrarModal();
  });

  // ── Leer parámetro ?q= de la URL al entrar ──────────────────
  const params = new URLSearchParams(window.location.search);
  const qUrl   = params.get('q');
  if (qUrl) {
    document.getElementById('buscador').value = qUrl;
  }

  // ── Iniciar ───────────────────────────────────────────────────
  cargarLibros();
</script>