---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Contacto · Biblioteca Central ULS"
  description="Contacta a un bibliotecario o reporta un problema."
  eyebrow="Apoyo"
  heading="Pregunta a un bibliotecario"
  subheading="¿Tienes dudas? Escríbenos y un bibliotecario te responderá."
>

  <div class="max-w-6xl mx-auto px-6 py-16">

    <div class="grid gap-8 lg:grid-cols-2">

      <!-- FORMULARIO -->
      <section
        class="rounded-3xl border border-blue-100 bg-white p-8 shadow-xl hover:shadow-2xl transition duration-300"
      >

        <h2 class="text-3xl font-bold text-blue-700 flex items-center gap-2">
          📩 Escríbenos
        </h2>

        <p class="mt-2 text-sm text-stone-600">
          Te responderemos en un plazo de 48 horas hábiles.
        </p>

        <form id="formContacto" class="mt-8 space-y-5">

          <!-- NOMBRE -->
          <div>

            <label
              for="nombre"
              class="block text-sm font-semibold text-stone-700"
            >
              Nombre
            </label>

            <div class="relative mt-2">

              <span class="absolute left-4 top-3 text-gray-400">
                👤
              </span>

              <input
                id="nombre"
                name="nombre"
                type="text"
                required
                class="w-full rounded-xl border border-blue-100 bg-slate-50 pl-12 pr-4 py-3 text-sm focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-200"
              />

            </div>

          </div>

          <!-- EMAIL -->
          <div>

            <label
              for="email"
              class="block text-sm font-semibold text-stone-700"
            >
              Correo electrónico
            </label>

            <div class="relative mt-2">

              <span class="absolute left-4 top-3 text-gray-400">
                📧
              </span>

              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full rounded-xl border border-blue-100 bg-slate-50 pl-12 pr-4 py-3 text-sm focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-200"
              />

            </div>

          </div>

          <!-- TEMA -->
          <div>

            <label
              for="tema"
              class="block text-sm font-semibold text-stone-700"
            >
              Tema
            </label>

            <select
              id="tema"
              name="tema"
              class="mt-2 w-full rounded-xl border border-blue-100 bg-slate-50 px-4 py-3 text-sm focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-200"
            >
              <option>Consulta general</option>
              <option>Apoyo en investigación</option>
              <option>Préstamo y devolución</option>
              <option>Acceso a recursos electrónicos</option>
              <option>Inscripción a evento</option>
            </select>

          </div>

          <!-- MENSAJE -->
          <div>

            <label
              for="mensaje"
              class="block text-sm font-semibold text-stone-700"
            >
              Mensaje
            </label>

            <div class="relative mt-2">

              <span class="absolute left-4 top-3 text-gray-400">
                📝
              </span>

              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class="w-full rounded-xl border border-blue-100 bg-slate-50 pl-12 pr-4 py-3 text-sm focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-200"
              ></textarea>

            </div>

          </div>

          <!-- BOTÓN -->
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-sky-500 to-blue-600 hover:scale-105 active:scale-95 transition duration-300 text-white py-3 rounded-xl font-semibold shadow-md"
          >
            Enviar mensaje
          </button>

          <!-- MENSAJE -->
          <p
            id="msgOk"
            class="hidden text-sm font-semibold text-green-700"
          >
            ✅ ¡Gracias! Tu mensaje fue enviado correctamente.
          </p>

        </form>

      </section>

      <!-- INFORMACIÓN -->
      <aside class="space-y-6">

        <!-- CONTACTO -->
        <div
          class="rounded-3xl border border-blue-100 bg-white p-8 shadow-xl hover:shadow-2xl transition duration-300"
        >

          <h2 class="text-2xl font-bold text-blue-700">
            📞 Datos de contacto
          </h2>

          <dl class="mt-6 space-y-5 text-sm">

            <div>
              <dt class="font-semibold text-stone-500">
                Correo
              </dt>

              <dd>
              <a
                href="mailto:karlaacevedo160@gmail.com"
                class="text-blue-700 hover:text-blue-900"
              >
                karlaacevedo160@gmail.com
              </a>
              </dd>
            </div>

            <div>
              <dt class="font-semibold text-stone-500">
                Teléfono
              </dt>

              <dd class="text-stone-800">
                +503 74385953
              </dd>
            </div>

            <div>
              <dt class="font-semibold text-stone-500">
                Sede central
              </dt>

              <dd class="text-stone-800">
                San Salvador, El Salvador
              </dd>
            </div>

            <div>
              <dt class="font-semibold text-stone-500">
                Horario de atención
              </dt>

              <dd>
                <a
                  href="/horarios"
                  class="text-blue-700 hover:text-blue-900"
                >
                  Ver horarios →
                </a>
              </dd>
            </div>

          </dl>

        </div>

        <!-- REPORTE -->
        <div
          id="reportar"
          class="scroll-mt-28 rounded-3xl border border-blue-100 bg-white p-8 shadow-xl hover:shadow-2xl transition duration-300"
        >

          <h2 class="text-2xl font-bold text-blue-700">
            ⚠️ Reportar un problema
          </h2>

          <p class="mt-3 text-sm text-stone-600 leading-6">
            ¿Encontraste un error en el sitio,
            un libro mal catalogado o un problema
            de accesibilidad? Cuéntanos.
          </p>

          <a
            href="mailto:karlaacevedo160@gmail.com"
            class="mt-6 inline-flex items-center rounded-xl border border-blue-300 px-5 py-3 text-sm font-semibold text-blue-700 hover:border-blue-500 hover:bg-blue-50 transition"
          >
            Enviar reporte por correo
          </a>

        </div>

      </aside>

    </div>

  </div>

</PageLayout>

<script is:inline>

document
  .getElementById("formContacto")
  ?.addEventListener("submit", async (e) => {

    e.preventDefault();

    const form = e.target;

    const datos = {
      nombre: document.getElementById("nombre").value,
      email: document.getElementById("email").value,
      tema: document.getElementById("tema").value,
      mensaje: document.getElementById("mensaje").value
    };

    try {

      const response = await fetch("/api/contacto", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(datos)
      });

      const result = await response.json();

      if (result.success) {

        form.reset();

        const ok = document.getElementById("msgOk");

        ok.classList.remove("hidden");

        setTimeout(() => {
          ok.classList.add("hidden");
        }, 5000);

      } else {

        alert("Error al enviar el correo");

      }

    } catch (error) {

      console.error(error);
      alert("No se pudo enviar el correo");

    }

  });

</script>