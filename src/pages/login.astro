---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopUtilityBar from '../components/TopUtilityBar.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Iniciar sesión · Biblioteca Central ULS"
  description="Accede a tu cuenta de la Biblioteca Central ULS."
>
  <TopUtilityBar />
  <AnnouncementBar />
  <SiteHeader />

  <main id="contenido-principal">
    <section class="relative flex min-h-[calc(100vh-180px)] items-center justify-center overflow-hidden bg-gradient-to-b from-blue-50 to-white px-4 py-14">

      <!-- Blobs decorativos -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.12]" aria-hidden="true">
        <div class="absolute -left-24 top-10 h-80 w-80 rounded-full bg-blue-500 blur-3xl"></div>
        <div class="absolute -right-20 bottom-0 h-96 w-96 rounded-full bg-blue-400 blur-3xl"></div>
      </div>

      <!-- Card -->
      <div class="relative z-10 w-full max-w-[460px] overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-xl shadow-blue-200/40">

        <!-- Cabecera con logo ULS sobre fondo claro -->
        <div class="bg-gradient-to-br from-blue-50 to-white border-b border-blue-100 px-8 py-7 text-center">
          <img src="/logo-uls.png" alt="Logo Universidad Luterana Salvadoreña" class="mx-auto mb-3 h-20 w-auto" />
          <h1 class="font-display text-2xl font-bold text-blue-900">Iniciar sesión</h1>
          <p class="mt-1 text-sm text-stone-600">Accede a tu cuenta</p>
        </div>

        <!-- Formulario -->
        <div class="px-8 pb-8 pt-6">

          <div id="alerta" class="hidden mb-4 rounded-lg px-4 py-3 text-sm font-medium" role="alert"></div>

          <form id="loginForm" novalidate>

            <div class="mb-4">
              <label for="email" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">Correo electrónico</label>
              <input id="email" name="email" type="email" placeholder="correo@uls.edu.sv" autocomplete="email" required
                class="w-full rounded-lg border border-blue-200 bg-blue-50 px-3.5 py-2.5 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200" />
            </div>

            <div class="mb-5">
              <label for="password" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">Contraseña</label>
              <input id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required
                class="w-full rounded-lg border border-blue-200 bg-blue-50 px-3.5 py-2.5 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200" />
            </div>

            <button type="submit"
              class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
              Entrar
            </button>

            <p class="mt-5 text-center text-sm text-stone-600">
              ¿No tienes cuenta?
              <a href="/register" class="font-semibold text-blue-700 hover:text-blue-900 hover:underline">Regístrate aquí</a>
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('loginForm');
    const alerta = document.getElementById('alerta');

    function mostrarAlerta(mensaje, tipo) {
      alerta.textContent = mensaje;
      alerta.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border', 'border-red-200', 'bg-green-50', 'text-green-700', 'border-green-200');
      if (tipo === 'error') {
        alerta.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
      } else {
        alerta.classList.add('bg-green-50', 'text-green-700', 'border', 'border-green-200');
      }
    }

    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const datos = {
          email: document.getElementById('email').value.trim(),
          password: document.getElementById('password').value,
        };

        try {
          // URL correcta: /api/auth?action=login
          const response = await fetch('/api/auth?action=login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(datos),
          });

          const resultado = await response.json();

          // La API responde con { success, mensaje, usuario } o { error }
          if (!resultado.success) {
            mostrarAlerta(resultado.error || resultado.mensaje || 'Credenciales incorrectas', 'error');
            return;
          }

          localStorage.setItem('uls_usuario', JSON.stringify(resultado.usuario));
          mostrarAlerta('¡Bienvenido! Redirigiendo...', 'ok');

          setTimeout(() => {
            window.location.href = resultado.usuario.rol === 'admin' ? '/admin' : '/';
          }, 800);

        } catch (error) {
          console.error(error);
          mostrarAlerta('Error al iniciar sesión. Inténtalo de nuevo.', 'error');
        }
      });
    }
  });
</script>
