---
import PageLayout from '../layouts/PageLayout.astro';

const noticias = [
  { fecha: '15 Abr 2026', titulo: 'La biblioteca abre su nueva sala de exposiciones',         desc: 'Inauguración de una sala dedicada a exposiciones temporales y de fondos especiales.' },
  { fecha: '02 Mar 2026', titulo: 'Digitalización de 1.200 láminas botánicas históricas',     desc: 'Concluye la primera fase del proyecto de digitalización del fondo botánico.' },
  { fecha: '18 Feb 2026', titulo: 'Convenio con la Red Iberoamericana de Bibliotecas',         desc: 'Firma de acuerdo de cooperación e intercambio de recursos académicos.' },
];
---

<PageLayout
  title="Prensa · Biblioteca Central ULS"
  description="Noticias, comunicados y contacto de prensa de la Biblioteca Central ULS."
  eyebrow="Institucional"
  heading="Prensa"
  subheading="Comunicados, noticias y contacto para medios."
>
  <div class="grid gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-4">
      <h2 class="font-display text-xl font-semibold text-stone-900">Últimas noticias</h2>
      <ul class="space-y-4">
        {noticias.map((n) => (
          <li class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">{n.fecha}</p>
            <h3 class="mt-1 font-display text-lg font-semibold text-stone-900">{n.titulo}</h3>
            <p class="mt-2 text-sm text-stone-700">{n.desc}</p>
          </li>
        ))}
      </ul>
    </div>

    <aside class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm">
      <h3 class="font-display text-lg font-semibold text-stone-900">Contacto de prensa</h3>
      <p class="mt-2 text-sm text-stone-700">Para entrevistas, fotografías o información institucional.</p>
      <dl class="mt-4 space-y-2 text-sm">
        <div><dt class="font-semibold text-stone-500">Correo</dt><dd><a href="mailto:prensa@uls.edu.sv" class="text-blue-700 hover:text-blue-900">prensa@uls.edu.sv</a></dd></div>
        <div><dt class="font-semibold text-stone-500">Teléfono</dt><dd class="text-stone-800">+503 0000-0000</dd></div>
      </dl>
      <a href="/contacto" class="mt-4 inline-flex items-center rounded-full border border-blue-300 px-4 py-2 text-sm font-semibold text-blue-700 hover:border-blue-500">
        Formulario de contacto
      </a>
    </aside>
  </div>
</PageLayout>
