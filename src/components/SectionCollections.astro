---
---

<section id="colecciones" class="border-b border-blue-200 bg-blue-50 py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 lg:px-6">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-blanck-900 sm:text-4xl">
          Haciendo nuestras colecciones accesibles para todos
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-black-700">
          Digitalizamos y describimos materiales originales de nuestros fondos para que cualquier persona pueda
          descubrirlos y usarlos en línea, con los más altos estándares de preservación.
        </p>
        <a
          href="/colecciones"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-800 transition"
        >
          Explorar colecciones digitales
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Imagen clicable -->
      <a
        href="/colecciones"
        class="group relative block aspect-[4/3] overflow-hidden rounded-2xl bg-stone-200 shadow-inner"
        aria-label="Explorar colecciones digitales"
      >
        <div
          class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=1200&q=80')] bg-cover bg-center transition duration-500 group-hover:scale-105"
          role="img"
          aria-label="Interior de biblioteca con estanterías y lectores"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-stone-900/60 to-transparent"></div>
        <p class="absolute bottom-4 left-4 max-w-xs text-sm font-medium text-white drop-shadow">
          Archivo, libros raros y patrimonio documental al alcance de la comunidad.
        </p>
      </a>

    </div>
  </div>
</section>
