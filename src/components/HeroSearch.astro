---
---

<section class="relative overflow-hidden border-b border-[#5b9fd4] bg-gradient-to-b from-[#5b9fd4] to-[#3b82c4]" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 opacity-[0.15]" aria-hidden="true">
    <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-white blur-3xl"></div>
    <div class="absolute -right-20 bottom-0 h-80 w-80 rounded-full bg-white blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:py-20 lg:px-6 lg:py-24">
    <p class="text-center text-sm font-semibold uppercase tracking-[0.2em] text-blanck/70">Bienvenido</p>
    <h1
      id="hero-title"
      class="mx-auto mt-3 max-w-4xl text-center font-display text-4xl font-semibold leading-tight tracking-tight text-blanck sm:text-5xl"
    >
      Biblioteca Central ULS
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-blanck/80">
      Somos el corazón documental de la universidad. Te ayudamos a descubrir, usar y crear conocimiento.
    </p>

    <div id="buscar" class="mx-auto mt-10 max-w-3xl scroll-mt-28">

      <!-- Formulario de búsqueda — redirige al catálogo con el texto -->
      <form
        id="heroForm"
        class="rounded-2xl border border-stone-200 bg-white p-2 shadow-sm shadow-stone-200/60"
        role="search"
        onsubmit="buscarEnCatalogo(event)"
      >
        <label for="q" class="sr-only">Buscar en el catálogo</label>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-stretch">
          <div class="relative flex-1">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-stone-400" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
              </svg>
            </span>
            <input
              id="q"
              name="q"
              type="search"
              placeholder="Libros, artículos, multimedia y más…"
              class="w-full rounded-xl border border-transparent bg-stone-50 py-3 pl-11 pr-4 text-stone-900 placeholder:text-stone-400 focus:border-[#1d6fad]/40 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1d6fad]/20"
            />
          </div>
          <div class="flex gap-2 sm:w-auto">
            <button
              type="submit"
              class="rounded-xl bg-[#1d6fad] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#155a8a] focus:outline-none focus:ring-2 focus:ring-[#1d6fad] focus:ring-offset-2"
            >
              Buscar
            </button>
          </div>
        </div>
      </form>

      <!-- Herramientas de búsqueda -->
      <div class="mt-6">
        <p class="text-center text-sm font-medium text-white/60">Otras herramientas de búsqueda</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-3 text-sm">
          <li>
            <a href="/catalogo" class="rounded-full border border-white/30 bg-white/10 px-4 py-2 font-medium text-white hover:bg-white/20 hover:border-white/50 transition">
              Catálogo integrado
            </a>
          </li>
          <li>
            <a href="/bases-datos" class="rounded-full border border-white/30 bg-white/10 px-4 py-2 font-medium text-white hover:bg-white/20 hover:border-white/50 transition">
              Búsqueda en bases de datos
            </a>
          </li>
          <li>
            <a href="/guias" class="rounded-full border border-white/30 bg-white/10 px-4 py-2 font-medium text-white hover:bg-white/20 hover:border-white/50 transition">
              Guías de fondos documentales
            </a>
          </li>
          <li>
            <a href="/repositorio" class="rounded-full border border-white/30 bg-white/10 px-4 py-2 font-medium text-white hover:bg-white/20 hover:border-white/50 transition">
              Repositorio institucional
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  // El botón Buscar redirige al catálogo con el texto escrito
  function buscarEnCatalogo(e) {
    e.preventDefault();
    const q = document.getElementById('q').value.trim();
    if (q) {
      window.location.href = '/catalogo?q=' + encodeURIComponent(q);
    } else {
      window.location.href = '/catalogo';
    }
  }
</script>